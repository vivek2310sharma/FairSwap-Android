<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FairSwap" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#0B1526</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.FairSwap.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1526</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.FairSwap</item>
    </style>
</resources>
