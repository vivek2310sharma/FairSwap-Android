    <string name="discovery_safety_tip_title">🛡️ सुरक्षित व्यापार सुझाव</string>
    <string name="discovery_safety_tip_1">• दिन के उजाले में एक सुरक्षित, सार्वजनिक स्थान पर मिलें।</string>
    <string name="discovery_safety_tip_2">• भुगतान पूरा करने से पहले आइटम का अच्छी तरह निरीक्षण करें।</string>
    <string name="discovery_safety_tip_3">• पैसे प्राप्त करने के लिए कभी भी अपना यूपीआई (UPI) पिन दर्ज न करें।</string>
    <string name="discovery_safety_tip_4">• अग्रिम शिपिंग शुल्क या असत्यापित भुगतान लिंक से बचें।</string>
    <string name="discovery_safety_tip_5">• साइबर अपराध/धोखाधड़ी की रिपोर्ट 1930 पर करें।</string>
    <string name="discovery_guest_login_button">लॉग इन करें</string>

    <!-- Hero & Marketing -->
    <string name="discovery_hero_headline">स्थानीय सौदों और निष्पक्ष व्यापार के लिए भारत का मार्केटप्लेस</string>
    <string name="discovery_hero_subhead">पास के सत्यापित पड़ोसियों के साथ सुरक्षित रूप से सामान खरीदें, बेचें और साझा करें।</string>
    <string name="discovery_hero_badge">आधिकारिक फेयरस्वैप लोकल हब</string>

    <!-- How It Works Section -->
    <string name="discovery_how_it_works_title">फेयरस्वैप कैसे काम करता है</string>
    <string name="discovery_how_it_works_subtitle">आपके पड़ोस में आसान 4-चरणीय स्थानीय व्यापार</string>
    <string name="discovery_step1_title">1. खोजें</string>
    <string name="discovery_step1_desc">पास में गुणवत्तापूर्ण पुराना सामान, वाहन और किराए के मकान खोजें।</string>
    <string name="discovery_step2_title">2. जुड़ें</string>
    <string name="discovery_step2_desc">फोन नंबर साझा किए बिना वास्तविक समय में विक्रेताओं से सुरक्षित रूप से चैट करें।</string>
    <string name="discovery_step3_title">3. जांचें</string>
    <string name="discovery_step3_desc">आइटम का अच्छी तरह से निरीक्षण करने के लिए दिन के उजाले में सार्वजनिक स्थान पर मिलें।</string>
    <string name="discovery_step4_title">4. अदला-बदली करें</string>
    <string name="discovery_step4_desc">संतुष्टि के बाद मौके पर ही भुगतान करें। शून्य अग्रिम शुल्क।</string>

    <!-- Indian Marketplace Safety Tips -->
    <string name="discovery_safety_section_title">🛡️ भारतीय मार्केटप्लेस सुरक्षा गाइड</string>
    <string name="discovery_safety_rule_upi_title">यूपीआई (UPI) प्राप्ति नियम</string>
    <string name="discovery_safety_rule_upi_desc">यूपीआई के माध्यम से पैसे प्राप्त करने के लिए कभी भी अपना पिन दर्ज करने, क्यूआर कोड स्कैन करने या अनुरोध स्वीकृत करने की आवश्यकता नहीं होती है।</string>
    <string name="discovery_safety_rule_army_title">फर्जी सेना अधिकारी घोटाले</string>
    <string name="discovery_safety_rule_army_desc">अग्रिम शिपिंग या बुकिंग टोकन मांगने वाले रक्षा अधिकारियों का ढोंग करने वाले धोखेबाजों से सावधान रहें।</string>
    <string name="discovery_safety_rule_courier_title">फर्जी कूरियर / लिंक घोटाले</string>
    <string name="discovery_safety_rule_courier_desc">कभी भी बाहरी भुगतान/कूरियर लिंक पर क्लिक न करें। सौदे व्यक्तिगत रूप से पूरे करें।</string>

