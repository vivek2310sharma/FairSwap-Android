    <!-- How It Works Section -->
    <string name="discovery_how_it_works_title">How FairSwap Works</string>
    <string name="discovery_how_it_works_subtitle">Simple 4-step local trading in your neighborhood</string>
    <string name="discovery_step1_title">1. Browse</string>
    <string name="discovery_step1_desc">Find quality pre-owned goods, vehicles &amp; rentals nearby.</string>
    <string name="discovery_step2_title">2. Connect</string>
    <string name="discovery_step2_desc">Chat securely with sellers in real time without sharing phone numbers.</string>
    <string name="discovery_step3_title">3. Inspect</string>
    <string name="discovery_step3_desc">Meet in daylight at a public place to check the item thoroughly.</string>
    <string name="discovery_step4_title">4. Exchange</string>
    <string name="discovery_step4_desc">Pay on the spot after satisfaction. Zero advance fee or hidden charges.</string>

    <!-- Indian Marketplace Safety Tips -->
    <string name="discovery_safety_section_title">🛡️ Indian Marketplace Safety Guide</string>
    <string name="discovery_safety_rule_upi_title">UPI Receiving Rule</string>
    <string name="discovery_safety_rule_upi_desc">Receiving money via UPI NEVER requires entering your PIN, scanning a QR code, or approving a request.</string>
    <string name="discovery_safety_rule_army_title">Fake Army Officer Scams</string>
    <string name="discovery_safety_rule_army_desc">Beware of fraudsters posing as defence officers asking for advance shipping or booking tokens.</string>
    <string name="discovery_safety_rule_courier_title">Fake Courier / Link Scams</string>
    <string name="discovery_safety_rule_courier_desc">Never click external payment/courier links. Complete deals in person.</string>

